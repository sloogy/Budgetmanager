# =============================================================
# BudgetManager — .gitignore
# =============================================================

# --- AI-Tools & Agent-State (NICHT versionieren) ---
.ai/
.claude/
.gemini/
.codex/
.copilot/
.cursor/

# AI-Markdown-Artefakte
AGENTS.md
CLAUDE.md
SUMMARY.md
ANALYSE_*.md
ANALYSYS_*.md
UI_KONSISTENZ_ANALYSE.md
BUGFIX*.md
BUGFIX_COMPLETED.md
*_ANALYSE.md
*_ANALYSIS.md
last_review.md
.ai_dispatch/

# --- Python ---
.pytest_cache/
__pycache__/
*.py[cod]
*.pyo
.venv*/
venv*/
.env

# --- Build/Packaging ---
build/
dist/
# *.spec ist NICHT ignoriert – wird für GitHub Actions benötigt!

# --- Logs/Temp ---
*.log
*.tmp
.DS_Store
Thumbs.db

# --- Backups / Exports ---
data/backups/*
!data/backups/.gitkeep
data/diagnostics/
*.bmr

# --- Build-Ausgaben ---
installer_output/
dist/
build/

# --- Data: User-spezifische Dateien (persönliche Daten!) ---
data/*.enc
data/users.json
data/budgetmanager_settings.json
budgetmanager_settings.json
data/*.log
data/*crash*.log
data/i18n_audit_report.txt
data/*.txt

# Der Vertrauensanker fuer Updates entsteht im Build aus der CI-Variable
# UPDATE_SIGNING_PUBLIC_KEY_B64. Er gehoert nicht in den Quellbaum - sonst
# waere unklar, welcher Schluessel gilt.
resources/update_signing_public_key.b64
# Das Schluesselpaar selbst gehoert nie ins Repository.
update-signing-key/

# Bei jedem Gate-Lauf neu erzeugt - versehentlich mit v3.0.7 eingecheckt.
# Die versionierten Nachweise unter audit_artifacts/ tragen eine Version im
# Namen; diese hier nicht, sie beschreiben immer nur den letzten Lauf.
.coverage
audit_artifacts/BANDIT_CURRENT.json
audit_artifacts/BANDIT_RELEASE_GATE.json
audit_artifacts/ENTERPRISE_RELEASE_AUDIT_10000.json
audit_artifacts/KILLCRITIC_USABILITY_10000.csv
audit_artifacts/KILLCRITIC_USABILITY_10000.json
audit_artifacts/coverage_full.json
audit_artifacts/coverage_gate_summary.json
