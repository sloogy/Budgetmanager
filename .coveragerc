[run]
branch = True
source = model,updater,utils,views
omit =
    tests/*
    tools/*
    */__pycache__/*

[report]
show_missing = True
skip_covered = True
precision = 1
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    if __name__ == .__main__.:

[xml]
output = audit_artifacts/coverage.xml

[html]
directory = audit_artifacts/htmlcov
