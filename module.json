{
  "schema": "lifeplanner.module.v2",
  "id": "budgetmanager",
  "name": "BudgetManager",
  "version": "2.4.1",
  "description": "Budget, Buchungen, Forecasts, Sparziele und Monatsabschluss.",
  "requires_host": ">=0.5.15,<1.0",
  "source_entry": "main.py",
  "windows_executable": "BudgetManager/BudgetManager.exe",
  "linux_executable": "BudgetManager/BudgetManager",
  "permissions": [
    "own_data_read",
    "own_data_write",
    "bridge_read",
    "bridge_write",
    "network_optional"
  ],
  "environment": {
    "BUDGETMANAGER_DATA_DIR": "{module_data_dir}",
    "LIFEPLANNER_MODULE_DATA_DIR": "{module_data_dir}",
    "LIFEPLANNER_BRIDGE_DIR": "{bridge_dir}",
    "LIFEPLANNER_CENTRAL_UPDATER": "1"
  },
  "bridge": {
    "publishes": [
      {
        "name": "BudgetManager → FPM",
        "file": "budgetmanager_to_fpm.jsonl",
        "schemas": [
          "fpm.import.v1",
          "fpm.expense.v1"
        ]
      },
      {
        "name": "Sparziele → FPM",
        "file": "budgetmanager_savings_goals.jsonl",
        "schemas": [
          "fpm.savings-goal.v1",
          "fpm.savings_goal.v1"
        ]
      }
    ],
    "subscribes": [
      {
        "name": "FPM → BudgetManager",
        "file": "fpm_to_budgetmanager.jsonl",
        "schemas": [
          "budgetmanager.import.v1"
        ]
      }
    ]
  }
}
